<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Authors>PulseOffice</Authors>
    <Version>0.3.0</Version>
    <Product>PulseOffice</Product>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>PulseOffice — GPL-3.0-only</Copyright>
    <NeutralLanguage>it</NeutralLanguage>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)PulseOffice.runsettings</RunSettingsFilePath>
  </PropertyGroup>
</Project>
